      "id": "api_routes_shadow_profile_merge",
      "label": "Shadow Profile Merge Endpoint",
      "file_type": "concept",
      "source_file": "API_ROUTES.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "POST /api/shadow-profile/merge migrates local (anonymous) items into the authenticated user's DB and marks the shadow as merged \u2014 the core anonymous-to-authenticated upgrade path."
    },
    {
      "id": "api_routes_events_api",
      "label": "Anonymized Events API",
      "file_type": "concept",
      "source_file": "API_ROUTES.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "POST /api/events requires no auth by design: events carry only eventType, salaryDaysBucket ranges, 6-char geohash (~610km) and a 15-minute-truncated timestamp so no PII is ever transmitted."
    },
    {
      "id": "api_routes_backup_api",
      "label": "Encrypted Backup API",
      "file_type": "concept",
      "source_file": "API_ROUTES.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "POST /api/backup/create returns an encrypted JSON blob the browser downloads; the user manually uploads it to Google Drive, keeping full control of the encryption key. Restore decrypts, validates structure, and inserts items."
    },
    {
      "id": "api_routes_gdpr_api",
      "label": "GDPR Consent and Deletion API",
      "file_type": "concept",
      "source_file": "API_ROUTES.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "POST /api/consent (anonymous allowed), DELETE /api/gdpr/delete-shadow (by UUID, no auth) and DELETE /api/gdpr/delete-account (authenticated, requires confirm:true) implement right-to-be-forgotten and consent registration."
    }
