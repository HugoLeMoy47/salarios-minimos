    {
      "id": "readme_dias_de_salario",
      "label": "D\u00edas de Salario Application",
      "file_type": "concept",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Web app that reframes prices as days of minimum-wage work to discourage impulsive spending; local-first (IndexedDB), optional OAuth sync, encrypted backups, anonymized analytics, MUI/MS365-inspired accessible UI (WCAG AA+)."
    },
    {
      "id": "readme_salary_days_calculation",
      "label": "Salary Days Calculation",
      "file_type": "concept",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Core metric: item price divided by NEXT_PUBLIC_MIN_SALARY_DAILY (241.56) rounded up with Math.ceil, because fractional work days cannot be sold."
    },
    {
      "id": "readme_meditation_chamber",
      "label": "Meditation Chamber (C\u00e1mara de Meditaci\u00f3n)",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Behavioral design: purchases exceeding 10% of monthly income automatically enter a 72-hour reflection period with a visual countdown; the user can cancel or wait, converting impulse purchases into deliberate decisions."
    },
    {
      "id": "readme_financial_health_summary",
      "label": "Financial Health Summary",
      "file_type": "concept",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Real-time indicators of 'days of life' committed, under evaluation, and recovered, with nudges when over-committing income and positive reinforcement when cancelling impulsive purchases."
    },
    {
      "id": "readme_credit_marketplace",
      "label": "Smart Credit Marketplace",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Business model: financial-product offers with preferential rates gated by the user's self-control history; requesting information registers the user's 'Meditation Score' as a lead for lenders \u2014 better offers unlock as financial responsibility is demonstrated."
    },
    {
      "id": "readme_retry_helper",
